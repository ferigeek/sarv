# Database
DB_NAME=sarv
DB_USERNAME=postgres
DB_PASSWORD=your-password

# JWT
JWT_SECRET=your-secret
JWT_EXPIRATION=3600000

# Internal service URL (keep default for compose networking)
RECOMMENDATION_URL=http://recommendation:8000

# --- Production reverse proxy (Caddy) ---
# Public domains that point to this host (A/AAAA records required for ACME).
# Caddy will automatically obtain and renew TLS certificates for these.
FRONTEND_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Optional but recommended: contact email for Let's Encrypt expiry notices.
# Leave empty if not needed — Caddy still issues certificates.
ACME_EMAIL=admin@example.com
